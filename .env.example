# Password accounts and demo plant orders work without external providers.
APP_URL=http://127.0.0.1:3000

# Web OAuth client for this app. Register APP_URL/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# RevenueCat server verification: use only this app's environment/products.
# All four server fields are required for webhooks, snapshots and authenticated sync.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_ENVIRONMENT=sandbox
REVENUECAT_ALLOWED_PRODUCT_IDS=

# Optional checkout: keep public SDK key empty to process webhooks with checkout disabled.
# A valid matching public key additionally enables account checkout; never put a secret here.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
REVENUECAT_OFFERING_ID=
# Set only when RevenueCat HMAC signing is enabled with this matching signing secret.
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_MANAGEMENT_HOSTS=

# Enable a client IP header only if your ingress overwrites it.
TRUSTED_CLIENT_IP_HEADER=none

# SHA-256 of a private random owner key. Never commit the raw key.
ADMIN_KEY_HASH=
